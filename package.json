{
    "name":  "dsh-opensquilla",
    "version": "0.1.3",
    "description":  "Intelligent model routing, image-aware history degradation, and TokenRhythm/DeepSeek balance for DeepSeek Harness",
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./cordis.patch.yml":  "./cordis.patch.yml",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**/*.js",
                  "python/squilla_router_service.py",
                  "cordis.patch.yml",
                  "NOTICE.md",
                  "README.md",
                  "LICENSE",
                  "package.json"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [

                                          ],
                               "platform":  "web"
                           }
            },
    "license":  "Apache-2.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "pnpm exec tsc -p tsconfig.build.json",
                    "build:client":  "node scripts/build-client.mjs",
                    "pack:release":  "pnpm run build \u0026\u0026 pnpm run build:client"
                },
    "dependencies":  {
                         "eventsource-parser":  "^3.1.0",
                         "@deepseek-ai/dsh-settings":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-launch-environment":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-credentials":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-system-prompt":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-anonymous-user-id":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-agent":  "0.1.1-rc.1",
                         "@deepseek-ai/dsh-llm":  "0.1.1-rc.1",
                         "@deepseek-ai/cordis":  "4.0.1",
                         "@deepseek-ai/dsh-attachment":  "0.1.1-rc.1",
                         "@deepseek-ai/schemastery":  "3.18.1",
                         "@deepseek-ai/dsh-timeout":  "0.1.1-rc.1"
                     }
}